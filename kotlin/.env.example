# Copy to .env (gitignored) and source it for local runs, or set the same variables in the
# IntelliJ run config (.run/BootKt.run.xml). Fixtures and public defaults only — a real secret
# never lives here.
KTOR_PORT=8080
LOG_LEVEL=INFO
LOGBACK_LOG_LEVEL=INFO

# Dev telemetry fixtures — no real endpoint or credential. Set TELEMETRY_CONSOLE=true for the
# fully offline path (console exporters instead of OTLP); prod requires OTEL_EXPORTER_OTLP_ENDPOINT.
OTEL_SERVICE_NAME=template
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
TELEMETRY_CONSOLE=false

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=template
