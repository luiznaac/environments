# Copy to .env for local runs. Every value has a sane default in settings.py.
APP_ENV=dev
HTTP_PORT=8080
LOG_LEVEL=INFO

MYSQL__HOST=localhost
MYSQL__PORT=3306
MYSQL__USER=root
MYSQL__PASSWORD=
MYSQL__DATABASE=template

# Unset follows HTTP_PORT (http://localhost:<port>); set explicitly to override (container/deploy).
# GATEWAYS__APP__HOST=http://localhost:8080

# Telemetry — dev fixtures only. The endpoint defaults to a local Collector under
# APP_ENV=dev and is required under APP_ENV=prod; APP_ENV=test exports nothing.
# OTEL_SERVICE_NAME=template
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# TELEMETRY_CONSOLE=false
# SERVICE_VERSION=dev

# The standard contract the exporters and instrumentation read.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=none
OTEL_BLRP_SCHEDULE_DELAY=5000
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative
OTEL_SEMCONV_STABILITY_OPT_IN=http,database
