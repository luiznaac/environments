# Base URL of the backend API.
# In dev, leave as "/api" and Vite proxies to VITE_API_TARGET (see vite.config.ts).
# In prod behind the reverse proxy, set to e.g. "/template-api" or the absolute origin.
VITE_API_BASE=/api

# Dev-only: where the Vite proxy forwards /api to, and the port the dev server binds.
# The dev server is strict — a taken FRONTEND_DEV_PORT fails instead of auto-incrementing.
VITE_API_TARGET=http://localhost:8080
FRONTEND_DEV_PORT=5273
